APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Display/business timezone, e.g. Asia/Kolkata. Set before collecting data; stored times use it.
APP_TIMEZONE=UTC
# Hosts (with port) whose browser sessions may call /api (offline queue). Defaults to APP_URL's host.
# SANCTUM_STATEFUL_DOMAINS=localhost:8000,hr.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local development account created by `php artisan db:seed`; set a unique password before seeding.
SEED_USER_NAME="SWS Admin"
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=
# Fake demo users/data (local only by default). Set false to seed only roles, permissions and the admin.
SEED_DEMO_DATA=

# Phone push notifications via Expo (needs the mobile app built with an EAS project id)
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=

# Desktop app update offered to employees (https URL + SHA-256 of the installer)
DESKTOP_LATEST_VERSION=
DESKTOP_DOWNLOAD_URL=
DESKTOP_SHA256=
DESKTOP_RELEASE_NOTES=

# Mobile / desktop sign-in lasts this many days
API_TOKEN_DAYS=30

# WhatsApp alerts for check-in / check-out / leave (off until configured).
# Provider: "meta" (WhatsApp Cloud API) or "webhook" (Twilio/Interakt/WATI/Gupshup etc.)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
WHATSAPP_NOTIFY_MANAGER=true
WHATSAPP_NOTIFY_PERMISSION=hr.manage
WHATSAPP_DEFAULT_CC=91
WHATSAPP_FIXED_RECIPIENTS=
WHATSAPP_EVENTS=check_in,check_out,leave_applied

# Telegram notifications (official Bot API, free). Create the bot with @BotFather; never commit real values.
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_QUEUE_CONNECTION=database
