{
  "expo": {
    "name": "SWS HR",
    "slug": "sws-hr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sws.hr"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sws.hr"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SWS HR uses your location only at the moment you check in or out, when your company requires check-in at an office."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SWS HR lets you attach a photo of a bill to an expense claim.",
          "cameraPermission": "SWS HR lets you take a photo of a bill for an expense claim."
        }
      ]
    ],
    "scheme": "swshr",
    "extra": {
      "apiUrl": "https://hrms.sohamsolution.com"
    }
  }
}
